# ==========================================================================
# .env.sample
# ==========================================================================
# Copy to `.env` and fill in real values for local development. On Posit
# Connect, set these as environment variables on the deployed content instead
# of shipping a `.env` file.
#
# The Local Development Tracker reads ALL of its data live from Databricks
# Unity Catalog (schema prd_mega.sgpbpi163). The DATABRICKS_* variables below
# are REQUIRED - the app raises EnvironmentError on startup if any is missing.
# ==========================================================================

# --------------------------------------------------------------------------
# Databricks SQL warehouse + OAuth service principal (REQUIRED)
# --------------------------------------------------------------------------
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# --------------------------------------------------------------------------
# Unity Catalog location
# --------------------------------------------------------------------------
LDT_CATALOG=prd_mega
LDT_SCHEMA=sgpbpi163

# Planning-documents Volume that backs the Strategy Inventory page.
LDT_DOCUMENTS_VOLUME=/Volumes/prd_mega/sgpbpi163/vgpbpi163/LDT/Local Development Plans

# --------------------------------------------------------------------------
# Query cache (in-memory, per worker process)
# --------------------------------------------------------------------------
QUERY_CACHE_TTL_SECONDS=300
QUERY_CACHE_MAX_ENTRIES=256

# --------------------------------------------------------------------------
# App server
# --------------------------------------------------------------------------
# Port the Dash dev server binds to when running `python app.py` locally.
# Posit Connect assigns its own port/proxy and does not need this set.
PORT=8050

# Set to "false" to disable Dash's debug/hot-reload mode (recommended for any
# shared or production-like environment).
DASH_DEBUG=true

# Log level for the app + query layer (DEBUG, INFO, WARNING, ERROR).
LDT_LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Offline development only
# --------------------------------------------------------------------------
# Set to 1 to read the bundled JSON snapshots in assets/data/<country>/
# instead of Databricks. Intended for offline UI work and the test suite;
# never set this in a real deployment.
# LDT_USE_LOCAL_DATA=1
