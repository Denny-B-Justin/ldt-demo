# ==========================================================================
# .env.example
# ==========================================================================
# Copy this file to `.env` (and fill in real values) for local development.
# On Posit Connect, set these as environment variables on the deployed
# content instead of shipping a `.env` file.
#
# The app is fully functional with NO variables set: it falls back to the
# bundled JSON snapshots in assets/data/. Supabase and AI variables are only
# needed if you want the app to read live data / call an LLM.
# ==========================================================================

# --------------------------------------------------------------------------
# Supabase (optional) - primary data source for live score/indicator values
# and the strategy inventory table. Leave blank to use the bundled JSON
# fallback data in assets/data/<country>/.
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# AI planning brief (optional) - only needed if you extend the app with the
# OpenAI/Exa-backed planning-brief workflow described in README.md's
# "What was intentionally simplified" section. Not required for the core
# analytics, maps, strategy inventory, or static content pages.
# --------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EXA_API_KEY=
AI_GENERATION_ENABLED=false
AI_PROMPT_VERSION=v1
AI_INVALIDATION_VERSION=v1
AI_ADMIN_TOKEN=

# --------------------------------------------------------------------------
# App server
# --------------------------------------------------------------------------
# Port the Dash dev server binds to when running `python app.py` locally.
# Posit Connect assigns its own port/proxy automatically and does not need
# this variable set.
PORT=8050

# Set to "false" to disable Dash's debug/hot-reload mode (recommended for
# any shared or production-like environment).
DASH_DEBUG=true
